{
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(higgsfield:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(python3:*)",
      "mcp__ElevenLabs__*",
      "mcp__Higgsfield__*",
      "mcp__ffmpeg__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/resume.sh\""
          }
        ]
      }
    ]
  }
}